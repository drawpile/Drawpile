+    static int mapAndroidKey(int key, bool &outKeyUpOnly)
     {
+        // For weird Lenovo Tab stylus behavior, see comment below.
+        outKeyUpOnly = false;
+
         // 0--9        0x00000007 -- 0x00000010
         if (key >= 0x00000007 && key <= 0x00000010)
