+    private void initializeInsets()
+    {
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.BAKLAVA) {
+            try {
+                setOnApplyWindowInsetsListener(new View.OnApplyWindowInsetsListener() {
+                    @Override
+                    public WindowInsets onApplyWindowInsets(View v, WindowInsets windowInsets) {
+                        try {
+                            int typeMask = WindowInsets.Type.displayCutout();
+                            if (!m_fullScreen) {
+                                typeMask |= WindowInsets.Type.systemBars();
+                            }
+                            Insets insets = windowInsets.getInsets(typeMask);
+                            m_insetLeft = insets.left;
+                            m_insetTop = insets.top;
+                            m_insetRight = insets.right;
+                            m_insetBottom = insets.bottom;
+                        } catch (Exception e) {
+                            Log.e(QtNative.QtTAG, "DPINPUT Error applying insets", e);
+                        }
+                        return windowInsets;
+                    }
+                });
+            } catch (Exception e) {
+                Log.e(QtNative.QtTAG, "DPINPUT Error setting insets listener", e);
+            }
+        }
+    }
+
